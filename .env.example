# ══════════════════════════════════════════════════════════════════════════
#  Talk-to-VI-IPPMS — environment template
#  Copy to .env on the target host, fill in the real secrets, chmod 600.
#      cp .env.example .env && chmod 600 .env
#  .env is gitignored and MUST NOT be committed.
# ══════════════════════════════════════════════════════════════════════════

# ══════════════════════════════════════════════════════════════════════════
#  ENVIRONMENT NAME — "prod" or "test". Determines ports + DB schema below.
#  Keep one .env per environment: /srv/ippms-assistant/{prod,test}/.env
# ══════════════════════════════════════════════════════════════════════════

# ── Upstream Instant Graph REST gateway ───────────────────────────────────
# 10.19.75.115 has NO ROUTE to 10.34.64.74:5001. All gateway traffic is
# relayed through FALCONPRD. See docs/MIGRATION_10.19.75.115.md §2.
#
# Squid CONNECT relay (recommended — TLS stays end-to-end, cert pinning
# keeps working, zero code change):
HTTPS_PROXY=http://10.19.71.246:3128
https_proxy=http://10.19.71.246:3128
# Never relay loopback or the GPU proxy — those are directly reachable:
NO_PROXY=127.0.0.1,localhost,10.19.71.246:8071,10.19.75.115
no_proxy=127.0.0.1,localhost,10.19.71.246:8071,10.19.75.115

INSTANT_GRAPH_BASE_URL=https://10.34.64.74:5001/api/api
# autossh-tunnel alternative: unset HTTPS_PROXY above and use
#   INSTANT_GRAPH_BASE_URL=https://127.0.0.1:5001/api/api
IG_REQUEST_TIMEOUT=30
IG_AUTH_HEADER_NAME=Authorization
IG_AUTH_HEADER_PREFIX="Bearer "
# The gateway is reached by IP but its cert SAN is a DNS name; both of these
# must be right or every upstream call fails TLS verification.
IG_CA_BUNDLE=/srv/ippms-assistant/prod/ig_selfsigned.pem
IG_CERT_HOSTNAME=ippms.vodafoneidea.com

# ── Postgres (shared by BOTH processes) ───────────────────────────────────
# 10.19.75.115 is the database host. After migration the app runs on this
# same box, so this may become 127.0.0.1 — see the migration doc.
IG_DB_HOST=127.0.0.1             # app now lives on the DB box
IG_DB_PORT=5432
IG_DB_NAME=conv_ai_db
IG_DB_USER=ig_app_user
IG_DB_PASSWORD=                 # ►► REQUIRED. Never commit the real value.
IG_DB_SCHEMA=tt_vi_ippms_schema          # prod
# IG_DB_SCHEMA=tt_vi_ippms_schema_test   # ►► test MUST use its own schema
IG_DB_CONNECT_TIMEOUT=5
IG_DB_POOL_MIN=1
IG_DB_POOL_MAX=5
IG_DB_SESSION_KEY=default        # use "test" for the test environment

# ── MCP server listeners (instant_graph_mcp_server_v2_5.py) ───────────────
# prod 8056/8060 · test 8156/8160
MCP_HOST=127.0.0.1               # keep internal: never publish the tool surface
MCP_PORT=8056
DASH_HOST=0.0.0.0
DASH_PORT=8060

# ── Chat app (talk_to_vi_ippms_updated_6_7_2.py) ──────────────────────────
# prod 8079 · test 8179
VI_APP_HOST=0.0.0.0
VI_APP_PORT=8079
MCP_SERVER_URL=http://127.0.0.1:8056/mcp   # test: 8156
MCP_CALL_TIMEOUT=45

# ── GPU inference proxy (mistral-7b) ──────────────────────────────────────
# .115 has no GPU, so this permanently points back at FALCONPRD. Plain HTTP,
# and it must NOT go through HTTPS_PROXY — hence the NO_PROXY entry above.
GPU_PROXY_URL=http://10.19.71.246:8071/v1/infer
GPU_API_KEY=                    # ►► REQUIRED. Never commit the real value.
GPU_TIMEOUT=180
DEFAULT_MODEL=mistral

# ── Bundled knowledge assets ──────────────────────────────────────────────
VI_TOOL_KB_PATH=/srv/ippms-assistant/prod/assets/vi_ippms_tool_kb.md
VI_QUESTION_GUIDE_PATH=/srv/ippms-assistant/prod/assets/vi_ippms_question_guide.xlsx
VI_RAG_TOP_K=5

# ── Behaviour knobs (defaults shown; safe to leave unset) ─────────────────
VI_FANOUT_MAX_WORKERS=12
VI_ANSWER_CACHE_TTL=300
VI_REACT_MAX_STEPS=8
VI_REACT_MAX_REPAIRS=1
VI_HOSTS_CACHE_TTL=300
VI_OBS_CHAR_CAP=3500
VI_CURRENT_VALUE_LOOKBACK_SECONDS=10800
VI_SPIKE_ROLLING_WINDOW=5
VI_SPIKE_ZSCORE_THRESHOLD=2.5
VI_SPIKE_MIN_POINTS=5
VI_CHAT_HISTORY_RETENTION_DAYS=7
VI_CHAT_HISTORY_SWEEP_INTERVAL=21600
VI_CHAT_HISTORY_MAX_CONVS=100
VI_DEBUG=1
LOG_LEVEL=INFO
