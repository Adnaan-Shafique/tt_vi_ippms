# /etc/systemd/system/talk-to-vi-ippms.service
#
#   sudo cp deploy/talk-to-vi-ippms.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now talk-to-vi-ippms
#
# Starts the chat UI (:8079). It is an MCP *client* — it pre-lists the MCP
# server's tools at startup, so instant-graph-mcp must be up first.
#
# NOTE: After= only orders startup, it does not wait for the MCP server to be
# *ready* to serve. RestartSec covers the race: if the chat app starts a beat
# early it logs "Could not pre-list MCP tools" and the restart picks it up.

[Unit]
Description=Talk-to-VI-IPPMS (conversational analytics chat UI)
Documentation=https://github.com/adnaan-shafique/tt_vi_ippms
After=network-online.target instant-graph-mcp.service
Wants=network-online.target
Requires=instant-graph-mcp.service

[Service]
Type=simple
User=ippms
Group=ippms
WorkingDirectory=/srv/ippms-assistant
EnvironmentFile=/srv/ippms-assistant/.env
ExecStart=/srv/ippms-assistant/.venv/bin/python src/talk_to_vi_ippms_updated_6_7_2.py
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tt-vi-ippms

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ippms-assistant

[Install]
WantedBy=multi-user.target
