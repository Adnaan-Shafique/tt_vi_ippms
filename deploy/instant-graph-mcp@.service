# /etc/systemd/system/instant-graph-mcp@.service
#
#  TEMPLATE UNIT — %i is the environment name: "prod" or "test".
#    sudo systemctl enable --now instant-graph-mcp@prod
#    sudo systemctl enable --now instant-graph-mcp@test
#
#  Each instance is a fully independent deployment: its own checkout, its own
#  venv, its own .env, its own ports, its own Postgres schema. Nothing is
#  shared, so restarting test can never disturb prod.
#
#  Serves the FastMCP endpoint + the Dash ops console (ports come from .env).

[Unit]
Description=Instant Graph MCP Server (%i)
Documentation=https://github.com/adnaan-shafique/tt_vi_ippms
After=network-online.target
Wants=network-online.target
# Uncomment if using the autossh fallback instead of the squid relay:
# Requires=autossh-ig-tunnel.service
# After=autossh-ig-tunnel.service

[Service]
Type=simple
User=ippms
Group=ippms
WorkingDirectory=/srv/ippms-assistant/%i
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/srv/ippms-assistant/%i/.env
ExecStart=/srv/ippms-assistant/%i/.venv/bin/python src/instant_graph_mcp_server_v2_5.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ig-mcp-%i

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ippms-assistant/%i

[Install]
WantedBy=multi-user.target
